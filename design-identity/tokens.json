{
  "$schema": "https://tr.designtokens.org/format/",
  "metadata": {
    "source": "https://nobaandstod.co.uk/",
    "extracted": "2026-08-12",
    "version": "1.0.0",
    "aesthetic": "Editorial",
    "notes": "Dark-first luxury editorial system. No CSS custom properties exist in the source; all tokens were recovered from compiled SCSS by frequency and selector-context analysis, then verified against a full-page screenshot. Tokens marked inferred in $description are not present in the source."
  },

  "color": {
    "primary": {
      "$value": "#dec497",
      "$type": "color",
      "$description": "Champagne gold. The only accent in the system - CTAs, hover states, monogram, closing CTA panel. hsl(38, 52%, 73%)"
    },
    "primary-dark": {
      "$value": "#cfa968",
      "$type": "color",
      "$description": "inferred - not in source. The source has no darker-gold hover; filled buttons invert to transparent instead. Provided for convenience only."
    },
    "primary-light": {
      "$value": "#eddec5",
      "$type": "color",
      "$description": "inferred - not in source. Tinted gold wash for focus rings and soft backgrounds."
    },
    "secondary": {
      "$value": "#f0eeeb",
      "$type": "color",
      "$description": "Warm bone. Heading text on dark grounds; background of inverted light sections. hsl(36, 14%, 93%)"
    },
    "accent": {
      "$value": "#ceccc5",
      "$type": "color",
      "$description": "Warm stone. Default body text colour on dark; hairline rules at 30% alpha. hsl(47, 8%, 79%)"
    },
    "ink": {
      "$value": "#131413",
      "$type": "color",
      "$description": "Deepest ink. Section grounds, footer, and text on gold surfaces. hsl(120, 3%, 8%)"
    },
    "charcoal": {
      "$value": "#2c2e2c",
      "$type": "color",
      "$description": "Warm charcoal. The page background. hsl(120, 2%, 18%)"
    },
    "white": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Pure white. Default outline-button text and navigation links - distinct from the warm bone used for headings. 18 uses in the source."
    },

    "neutral": {
      "50":  { "$value": "#f9f9f9", "$type": "color", "$description": "Pure light panels (rare)" },
      "100": { "$value": "#f0eeeb", "$type": "color", "$description": "Heading text on dark; light section background" },
      "200": { "$value": "#dfddd8", "$type": "color", "$description": "inferred - light-panel dividers" },
      "300": { "$value": "#ceccc5", "$type": "color", "$description": "Default body text on dark" },
      "400": { "$value": "#a2a29e", "$type": "color", "$description": "inferred - muted / de-emphasised text" },
      "500": { "$value": "#777777", "$type": "color", "$description": "Placeholder text" },
      "600": { "$value": "#606060", "$type": "color", "$description": "inferred - disabled text" },
      "700": { "$value": "#494949", "$type": "color", "$description": "Low-contrast decorative display text. ~1.9:1 on the page ground - never use at body size." },
      "800": { "$value": "#2c2e2c", "$type": "color", "$description": "Page background. Dark-first scale: 800/900 are grounds, 100/300 are text." },
      "900": { "$value": "#131413", "$type": "color", "$description": "Section / footer background; text on gold" }
    },

    "semantic": {
      "success":   { "$value": "#46b450", "$type": "color", "$description": "Mail-sent confirmation. Contact Form 7 plugin default, not brand-authored." },
      "warning":   { "$value": "#ffb900", "$type": "color", "$description": "Validation warning. Contact Form 7 plugin default, not brand-authored." },
      "error":     { "$value": "#e74c3c", "$type": "color", "$description": "Invalid field, destructive actions. Theme-authored." },
      "error-alt": { "$value": "#dc3232", "$type": "color", "$description": "Form submission error. Contact Form 7 plugin default." },
      "info":      { "$value": "#00a0d2", "$type": "color", "$description": "Informational notice. Contact Form 7 plugin default, not brand-authored." }
    },

    "surface": {
      "default": { "$value": "#2c2e2c",            "$type": "color", "$description": "Page background (body)" },
      "sunken":  { "$value": "#131413",            "$type": "color", "$description": "Section grounds (.bg-color-basic), footer, swiper controls" },
      "gold":    { "$value": "#dec497",            "$type": "color", "$description": "Full-width closing CTA panel" },
      "light":   { "$value": "#f0eeeb",            "$type": "color", "$description": "Inverted light sections" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.4)", "$type": "color", "$description": "Image scrim over hero photography" }
    },

    "alpha": {
      "white-30": { "$value": "rgba(255, 255, 255, 0.3)", "$type": "color", "$description": "Default button border; nav top/bottom hairlines" },
      "bone-30":  { "$value": "rgba(240, 238, 235, 0.3)", "$type": "color", "$description": "Bone hairline rule under section labels" },
      "stone-30": { "$value": "rgba(206, 204, 197, 0.3)", "$type": "color", "$description": "Stone hairline rule on cards" },
      "ink-70":   { "$value": "rgba(19, 20, 19, 0.7)",    "$type": "color", "$description": "Heavy ink scrim" },
      "ink-20":   { "$value": "rgba(19, 20, 19, 0.2)",    "$type": "color", "$description": "Light ink scrim" }
    }
  },

  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "Cormorant, Georgia, 'Times New Roman', serif",
        "$type": "fontFamily",
        "$description": "Display and heading text, weight 400 only. NOTE: the source declares this family as \"Сormorant\" with a leading U+0421 CYRILLIC CAPITAL ES - a typo. Use the Latin spelling shown here."
      },
      "body": {
        "$value": "Raleway, system-ui, -apple-system, sans-serif",
        "$type": "fontFamily",
        "$description": "Body, UI, navigation, buttons and labels. Weights 400 and 500 only."
      },
      "mono": {
        "$value": "monospace",
        "$type": "fontFamily",
        "$description": "No monospace family is defined in the source; it falls through to the browser default."
      }
    },

    "fontSize": {
      "xs":  { "$value": "0.75rem",  "$type": "dimension", "$description": "12px - captions, legal, footer meta (Raleway)" },
      "sm":  { "$value": "0.875rem", "$type": "dimension", "$description": "14px - nav links and buttons, uppercase (Raleway 500)" },
      "base":{ "$value": "1rem",     "$type": "dimension", "$description": "16px - body copy (Raleway 400)" },
      "lg":  { "$value": "1.125rem", "$type": "dimension", "$description": "18px - lead paragraphs" },
      "xl":  { "$value": "1.25rem",  "$type": "dimension", "$description": "20px - large body; mobile nav sets 21px" },
      "2xl": { "$value": "1.5rem",   "$type": "dimension", "$description": "24px - H4 (Cormorant)" },
      "3xl": { "$value": "1.875rem", "$type": "dimension", "$description": "30px - H3, mobile H2 (Cormorant)" },
      "4xl": { "$value": "2.375rem", "$type": "dimension", "$description": "38px - H2 (Cormorant)" },
      "5xl": { "$value": "3rem",     "$type": "dimension", "$description": "48px - primary section heading (Cormorant)" },
      "6xl": { "$value": "4.125rem", "$type": "dimension", "$description": "66px - large section display (Cormorant)" },
      "7xl": { "$value": "5.5rem",   "$type": "dimension", "$description": "88px - hero heading (Cormorant)" },
      "8xl": { "$value": "8rem",     "$type": "dimension", "$description": "128px - oversized editorial display (Cormorant)" }
    },

    "fontWeight": {
      "normal": { "$value": 400, "$type": "fontWeight", "$description": "Cormorant 400, Raleway 400" },
      "medium": { "$value": 500, "$type": "fontWeight", "$description": "Raleway 500 - nav, buttons, labels. The heaviest weight in the system." }
    },

    "lineHeight": {
      "none":    { "$value": 1.0, "$type": "number", "$description": "100% - hero and oversized display" },
      "tight":   { "$value": 1.2, "$type": "number", "$description": "120% - all headings" },
      "normal":  { "$value": 1.5, "$type": "number", "$description": "150% - UI, nav, buttons" },
      "relaxed": { "$value": 1.6, "$type": "number", "$description": "160% - body prose" }
    },

    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension", "$description": "All display and heading sizes (24px and above)" },
      "snug":   { "$value": "-0.01em", "$type": "dimension", "$description": "Body and UI sizes (12-21px)" },
      "normal": { "$value": "0",       "$type": "dimension", "$description": "Uppercase nav links and buttons - the source adds no tracking to uppercase" },
      "wide":   { "$value": "0.05em",  "$type": "dimension", "$description": "inferred - not used in source" },
      "wider":  { "$value": "0.1em",   "$type": "dimension", "$description": "inferred - not used in source" }
    }
  },

  "spacing": {
    "px": { "$value": "1px",   "$type": "dimension", "$description": "Hairline borders" },
    "1":  { "$value": "4px",   "$type": "dimension", "$description": "Tightest inline gaps" },
    "2":  { "$value": "8px",   "$type": "dimension", "$description": "Icon gaps" },
    "3":  { "$value": "12px",  "$type": "dimension", "$description": "Compact padding" },
    "4":  { "$value": "16px",  "$type": "dimension", "$description": "Standard component padding" },
    "5":  { "$value": "20px",  "$type": "dimension", "$description": "Button horizontal padding" },
    "6":  { "$value": "24px",  "$type": "dimension", "$description": "Mobile nav padding, burger icon width" },
    "7":  { "$value": "28px",  "$type": "dimension", "$description": "Medium gaps" },
    "8":  { "$value": "32px",  "$type": "dimension", "$description": "Component spacing" },
    "10": { "$value": "40px",  "$type": "dimension", "$description": "List item separation" },
    "12": { "$value": "50px",  "$type": "dimension", "$description": "Large component spacing (source uses 50px, not the conventional 48px)" },
    "14": { "$value": "56px",  "$type": "dimension", "$description": "Header top padding at rest" },
    "18": { "$value": "72px",  "$type": "dimension", "$description": "Large block spacing" },
    "20": { "$value": "80px",  "$type": "dimension", "$description": "Compact section gap; desktop nav gap" },
    "22": { "$value": "90px",  "$type": "dimension", "$description": "Large block spacing" },
    "25": { "$value": "100px", "$type": "dimension", "$description": "Medium section gap; sticky offset" },
    "31": { "$value": "125px", "$type": "dimension", "$description": "Extra-large block spacing" },
    "45": { "$value": "180px", "$type": "dimension", "$description": "Signature section rhythm - the most identity-defining measurement on the site" }
  },

  "layout": {
    "gutter":       { "$value": "15px",  "$type": "dimension", "$description": "Container side padding" },
    "headerPad":    { "$value": "56px",  "$type": "dimension", "$description": "Header top padding at rest; collapses to 14px on scroll over 300ms" },
    "headerHeight": { "$value": "100px", "$type": "dimension", "$description": "Scrolled header / nav drawer height" },
    "sectionY":     { "$value": "180px", "$type": "dimension", "$description": "Standard section padding, top and bottom (.pt-180 / .pb-180)" },
    "sectionYMd":   { "$value": "100px", "$type": "dimension", "$description": "Reduced section rhythm" },
    "sectionYSm":   { "$value": "80px",  "$type": "dimension", "$description": "Compact section rhythm" },
    "gridGapX":     { "$value": "180px", "$type": "dimension", "$description": "Editorial grid column gap" },
    "gridGapY":     { "$value": "80px",  "$type": "dimension", "$description": "Editorial grid row gap" },

    "container": {
      "max":  { "$value": "1440px", "$type": "dimension", "$description": "Container max width, with 15px gutters" },
      "wide": { "$value": "1920px", "$type": "dimension", "$description": "Full-bleed media ceiling" }
    },
    "measure": {
      "default": { "$value": "540px", "$type": "dimension", "$description": "Prose column max width - the editorial measure" },
      "narrow":  { "$value": "360px", "$type": "dimension", "$description": "Narrow card text" }
    },
    "breakpoint": {
      "sm":  { "$value": "768px",  "$type": "dimension", "$description": "Mobile to tablet. Source authors this desktop-first as max-width: 767px." },
      "md":  { "$value": "1100px", "$type": "dimension", "$description": "Tablet to desktop. Source: max-width: 1100px." },
      "lg":  { "$value": "1500px", "$type": "dimension", "$description": "Desktop. Source: max-width: 1500px." },
      "xl":  { "$value": "1520px", "$type": "dimension", "$description": "Wide desktop. Source: max-width: 1520px." },
      "2xl": { "$value": "1920px", "$type": "dimension", "$description": "Full-bleed ceiling" }
    },
    "zIndex": {
      "nav":    { "$value": 100,  "$type": "number", "$description": "Nav drawer" },
      "header": { "$value": 101,  "$type": "number", "$description": "Fixed header, above the drawer" },
      "cursor": { "$value": 1000, "$type": "number", "$description": "Custom cursor" }
    }
  },

  "borderRadius": {
    "none":    { "$value": "0",      "$type": "dimension", "$description": "THE DEFAULT - cards, images, panels, sections, inputs are all sharp" },
    "sm":      { "$value": "0",      "$type": "dimension", "$description": "Intentionally 0 - this design uses no small radii" },
    "md":      { "$value": "0",      "$type": "dimension", "$description": "Intentionally 0 - inputs are square" },
    "lg":      { "$value": "0",      "$type": "dimension", "$description": "Intentionally 0 - cards are square" },
    "xl":      { "$value": "0",      "$type": "dimension", "$description": "Intentionally 0 - panels are square" },
    "2xl":     { "$value": "0",      "$type": "dimension", "$description": "Intentionally 0 - feature sections are square" },
    "pill":    { "$value": "71px",   "$type": "dimension", "$description": "Buttons (.btn) - extracted verbatim" },
    "control": { "$value": "50px",   "$type": "dimension", "$description": "Swiper control cluster" },
    "circle":  { "$value": "50%",    "$type": "dimension", "$description": "Custom cursor, avatars" },
    "full":    { "$value": "9999px", "$type": "dimension", "$description": "Equivalent pill for arbitrary widths" }
  },

  "border": {
    "width":     { "$value": "1px", "$type": "dimension", "$description": "The only border width in the system" },
    "ruleHeight":{ "$value": "2px", "$type": "dimension", "$description": "Burger icon bars" },
    "hairline": {
      "$value": { "color": "rgba(255, 255, 255, 0.3)", "width": "1px", "style": "solid" },
      "$type": "border",
      "$description": "The system's signature edge: default button outlines and the nav drawer's top/bottom rules. Equivalent shorthand: 1px solid rgba(255, 255, 255, 0.3)"
    }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow", "$description": "THE SYSTEM DEFAULT. The source stylesheet contains no shadows at all - only box-shadow: none. Depth comes from colour contrast and full-bleed photography." },
    "sm":   { "$value": "0 1px 3px 0 rgba(19,20,19,0.24), 0 1px 2px -1px rgba(19,20,19,0.24)",   "$type": "shadow", "$description": "inferred - not in source. Tinted with brand ink. Using this departs from the source design." },
    "md":   { "$value": "0 4px 6px -1px rgba(19,20,19,0.28), 0 2px 4px -2px rgba(19,20,19,0.28)","$type": "shadow", "$description": "inferred - not in source." },
    "lg":   { "$value": "0 10px 15px -3px rgba(19,20,19,0.32), 0 4px 6px -4px rgba(19,20,19,0.32)","$type": "shadow", "$description": "inferred - not in source." },
    "xl":   { "$value": "0 20px 25px -5px rgba(19,20,19,0.38), 0 8px 10px -6px rgba(19,20,19,0.38)","$type": "shadow", "$description": "inferred - not in source." }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "75ms",  "$type": "duration", "$description": "inferred - not in source" },
      "fast":    { "$value": "150ms", "$type": "duration", "$description": "inferred - not in source" },
      "normal":  { "$value": "300ms", "$type": "duration", "$description": "THE SITE STANDARD. The only duration in the source - appears 24 times as transition: .3s and in every scoped transition. Use this for everything." },
      "slow":    { "$value": "400ms", "$type": "duration", "$description": "inferred - not in source" }
    },
    "easing": {
      "default":     { "$value": "ease",                       "$type": "cubicBezier", "$description": "The source's implicit default on bare transition: .3s" },
      "ease-in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)","$type": "cubicBezier", "$description": "Colour transitions - extracted from transition: color .3s ease-in-out" },
      "ease-out":    { "$value": "cubic-bezier(0, 0, 0.2, 1)",  "$type": "cubicBezier", "$description": "inferred - elements entering" },
      "ease-in":     { "$value": "cubic-bezier(0.4, 0, 1, 1)",  "$type": "cubicBezier", "$description": "inferred - elements leaving" }
    }
  }
}
